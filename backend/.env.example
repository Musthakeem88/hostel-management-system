PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostel_management
DB_USER=postgres
DB_PASSWORD=change-me

# Login tokens are JWTs signed with this secret. Use a long random value (32+ characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: how long a login lasts, in hours (default 8)
TOKEN_HOURS=8
