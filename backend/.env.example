PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostel_management
DB_USER=postgres
DB_PASSWORD=change_me

# Signs login tokens (JWT). Use a long random text; if empty, everyone is signed out on every restart
JWT_SECRET=change_me_to_a_long_random_text

# First administrator account, created only when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_Admin1

# Only used by `npm test` (this database is wiped on every run; name must end in _test)
# TEST_DB_NAME=hostel_management_test
